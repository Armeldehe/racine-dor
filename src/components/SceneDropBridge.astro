---
// Connective: A (Hero) and B (Racine) genuinely coexist here — the Hero
// photo is still visible while the Racine photo rises underneath it, the
// drop serving as the visual link between the two. No informational
// content, so it is hidden from the a11y tree entirely.
import { Image } from 'astro:assets';
import serumHeroMobile from '../assets/img/serum-hero-mobile.jpg';
import brandRootsClean from '../assets/img/brand-roots-clean.jpg';
---

<div
  class="drop-bridge"
  data-bridge-wrapper
  data-cta-label="Commander"
  data-cta-mode="compact"
  aria-hidden="true"
>
  <div class="drop-bridge__sticky">
    <Image
      src={brandRootsClean}
      alt=""
      widths={[480, 800]}
      sizes="100vw"
      loading="lazy"
      class="drop-bridge__layer drop-bridge__layer--under"
    />
    <Image
      src={serumHeroMobile}
      alt=""
      widths={[420, 700]}
      sizes="100vw"
      loading="lazy"
      class="drop-bridge__layer drop-bridge__layer--over"
      data-bridge-hero
    />
    <div class="drop-bridge__scrim" aria-hidden="true"></div>
    <svg class="drop-bridge__drop" data-bridge-drop viewBox="0 0 20 26" focusable="false">
      <path fill="#d9b968" d="M10 0c4 6 8 11.2 8 16.5A8 8 0 1 1 2 16.5C2 11.2 6 6 10 0Z"></path>
    </svg>
  </div>
</div>

<style>
  .drop-bridge {
    position: relative;
    height: 125svh;
    background: #171c11;
    /* Purely decorative connector, no interaction anywhere inside —
       never let it intercept a scroll/tap gesture meant for the page. */
    pointer-events: none;
  }
  .drop-bridge__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .drop-bridge__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .drop-bridge__layer--under {
    object-position: 65% 58%;
  }
  .drop-bridge__layer--over {
    object-position: 50% 38%;
    will-change: opacity;
  }
  .drop-bridge__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(10, 14, 8, 0.35) 0%, rgba(10, 14, 8, 0.5) 100%);
    pointer-events: none;
  }
  .drop-bridge__drop {
    position: absolute;
    left: 50%;
    top: 30%;
    width: 18px;
    height: auto;
    transform: translate(-50%, 0) scale(0.9);
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.45));
    z-index: 2;
    pointer-events: none;
    will-change: transform, opacity;
  }
</style>
