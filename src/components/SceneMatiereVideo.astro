---
// EXPERIMENTAL — Phase 6B/6C prototype. Hybrid PNG/CSS + scroll-scrubbed
// video + PNG/CSS. Lives only on /qa/chapitre-2b for now; the
// production Chapter 2 (ChapterMatiere.astro, /qa/chapitre-2) is
// untouched. One sticky stage, one continuous progression — see
// scroll-video-scrub.ts for the full band mapping.
//
// RESTORED to the Phase 6C state (last human-approved version) after
// Phase 6D was rejected as a regression. Do not modify further without
// explicit instruction.
import { Image } from 'astro:assets';
import serumCutout from '../assets/img/serum-cutout.png';
import butterTextureMacro from '../assets/img/butter-texture-macro.jpg';
import butterCutout from '../assets/img/butter-cutout.png';

const VIDEO_SRC = '/assets/video/PixVerse_V6_Image_Text_540P_Cinematic_macro_lu.mp4';
---

<div
  class="matter-video"
  data-matter-video
  data-cta-label="Commander"
  data-cta-mode="compact"
  aria-hidden="true"
>
  <div class="matter-video__stage">
    <div class="matter-video__layer matter-video__wash matter-video__wash--a" data-layer="wash-a"></div>
    <div class="matter-video__layer matter-video__wash matter-video__wash--b" data-layer="wash-b"></div>
    <div class="matter-video__layer matter-video__wash matter-video__wash--c" data-layer="wash-c"></div>

    <ul class="matter-video__words" data-layer="words" aria-hidden="true">
      <li data-word="1">NOURRIR</li>
      <li data-word="2">FORTIFIER</li>
      <li data-word="3">ACCOMPAGNER</li>
    </ul>

    <Image
      src={serumCutout}
      alt=""
      widths={[320, 480, 640]}
      sizes="70vw"
      loading="lazy"
      class="matter-video__layer matter-video__product"
      data-layer="serum"
    />

    <video
      class="matter-video__layer matter-video__motion"
      data-layer="video"
      src={VIDEO_SRC}
      muted
      playsinline
      preload="auto"
    ></video>

    <div class="matter-video__layer matter-video__disguise" data-layer="disguise" aria-hidden="true"></div>
    <div class="matter-video__layer matter-video__matter" data-layer="matter" aria-hidden="true"></div>

    <div class="matter-video__mask-wrap" data-layer="mask-wrap">
      <Image
        src={butterTextureMacro}
        alt=""
        widths={[480, 800]}
        sizes="100vw"
        loading="lazy"
        class="matter-video__layer matter-video__butter-texture"
      />
    </div>

    <Image
      src={butterCutout}
      alt=""
      widths={[260, 360, 460]}
      sizes="62vw"
      loading="lazy"
      class="matter-video__layer matter-video__butter-cutout"
      data-layer="butter-cutout"
    />
  </div>
</div>

<style>
  .matter-video {
    position: relative;
    height: 270svh;
    background: #1c150d;
    pointer-events: none;
  }
  .matter-video__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .matter-video__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .matter-video__wash {
    z-index: 0;
  }
  .matter-video__wash--a {
    background: radial-gradient(120% 90% at 50% 20%, #3a2c18 0%, #1c150d 68%);
  }
  .matter-video__wash--b {
    background: linear-gradient(180deg, #2c2013 0%, #4a2c18 100%);
    opacity: 0;
  }
  .matter-video__wash--c {
    background: linear-gradient(180deg, #ead9ae 0%, #f1e4c6 100%);
    opacity: 0;
  }

  .matter-video__words {
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    opacity: 0;
  }
  .matter-video__words li {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 13vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--text-on-dark);
  }
  .matter-video__words li[data-word='1'] {
    color: var(--gold-bright);
  }
  .matter-video__words li[data-word='2'] {
    opacity: 0.62;
  }
  .matter-video__words li[data-word='3'] {
    font-size: clamp(1.4rem, 8vw, 2.6rem);
    opacity: 0.32;
  }

  .matter-video__product {
    z-index: 2;
    object-fit: contain;
    top: 19%;
    left: 19%;
    width: 62%;
    height: 62%;
    transform-origin: 50% 22%;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.45));
    will-change: transform, opacity, filter;
  }

  .matter-video__motion {
    z-index: 3;
    opacity: 0;
    transform-origin: 50% 62%;
    will-change: opacity, filter, transform;
  }

  /* Vertical gold column, not a centred radial glow — a linear shape to
     disguise a linear artifact (the filament), blurred at its own edges
     so it blends rather than reading as a hard overlay. */
  .matter-video__disguise {
    z-index: 4;
    left: 26%;
    right: 26%;
    background: linear-gradient(
      180deg,
      rgba(240, 207, 122, 0) 0%,
      rgba(240, 207, 122, 0.92) 30%,
      rgba(240, 207, 122, 0.92) 70%,
      rgba(240, 207, 122, 0) 100%
    );
    filter: blur(22px);
    opacity: 0;
  }

  .matter-video__matter {
    z-index: 5;
    background: radial-gradient(45% 40% at 50% 58%, #f0cf7a 0%, #c98f3b 55%, rgba(74, 44, 24, 0) 78%);
    opacity: 0;
    transform-origin: 50% 58%;
    will-change: transform, opacity;
  }

  .matter-video__mask-wrap {
    position: absolute;
    inset: 0;
    z-index: 6;
    clip-path: circle(0% at 50% 58%);
  }
  .matter-video__butter-texture {
    transform: scale(1.08);
  }

  .matter-video__butter-cutout {
    z-index: 7;
    object-fit: contain;
    top: 20%;
    left: 20%;
    width: 60%;
    height: 60%;
    opacity: 0;
    clip-path: inset(60% 0% 0% 0%);
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.4));
    will-change: transform, opacity, clip-path;
  }
</style>
