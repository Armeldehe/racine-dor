---
import { Image } from 'astro:assets';
import rangeFinalHero from '../assets/img/range-final-hero.jpg';
import { buildWhatsAppLink, greetingFor } from '../config/site';

const href = buildWhatsAppLink(greetingFor('ma routine Racine d’Or'));
---

<section
  id="final-cta"
  class="final"
  data-cta-label="Commander sur WhatsApp"
  data-cta-mode="hidden"
  aria-labelledby="final-h"
>
  <Image
    src={rangeFinalHero}
    alt="Sérum, Beurre Rénovateur et Derma Roller Racine d'Or réunis, ambiance sombre et dorée"
    widths={[480, 800, 941]}
    sizes="100vw"
    loading="lazy"
    class="final__img"
    data-reveal
  />
  <div class="final__scrim" aria-hidden="true"></div>
  <div class="final__content">
    <h2 id="final-h" class="final__title" data-reveal>Tes racines méritent<br />leur routine.</h2>
    <p class="final__subtitle" data-reveal style="--i:1">Chaque goutte est un soin précieux pour tes racines.</p>
    <a
      class="final__cta"
      data-reveal
      style="--i:2"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      data-track-source="final_cta"
      data-track-item="generic"
      data-track-item-type="generic"
    >
      Commander sur WhatsApp
    </a>
  </div>
</section>

<style>
  .final {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
    background: var(--forest-deep);
  }
  .final__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    z-index: 0;
    transform-origin: 50% 55%;
    pointer-events: none;
  }
  /* A restrained "arrival" — the family shot settles into place rather
     than looping/bouncing — gated on scroll (reveal.ts) instead of firing
     unconditionally on paint, so it's still visible when scrolled into. */
  .js-reveal .final__img[data-reveal] {
    opacity: 1;
    transform: scale(1.08);
    filter: blur(6px);
    transition: transform 1100ms var(--ease), filter 1100ms var(--ease);
  }
  .js-reveal .final__img[data-reveal].is-visible {
    transform: scale(1);
    filter: blur(0);
  }
  .final__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(10, 12, 8, 0.15) 0%, rgba(10, 12, 8, 0.92) 100%);
    pointer-events: none;
  }
  .final__content {
    position: relative;
    z-index: 2;
    padding: var(--gutter);
    padding-bottom: calc(var(--gutter) + 20px);
    color: var(--text-on-forest);
    width: 100%;
    text-align: center;
  }
  .final__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.3rem, 10vw, 3.9rem);
    line-height: var(--lh-display);
    text-wrap: balance;
    max-width: 18ch;
    margin-inline: auto;
  }
  .js-reveal .final__title[data-reveal],
  .js-reveal .final__subtitle[data-reveal],
  .js-reveal .final__cta[data-reveal] {
    transition-delay: calc(var(--i, 0) * 200ms);
  }
  .final__subtitle {
    margin-top: 16px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--text-on-forest);
  }
  .final__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    margin-top: 28px;
    padding: var(--btn-padding-y) 32px;
    border-radius: var(--btn-radius);
    background: var(--gold-bright);
    color: #1b1607;
    font-family: var(--btn-font);
    font-weight: 800;
    font-size: var(--text-body);
    text-decoration: none;
  }

  /* Phase 10 — desktop: left-aligned editorial column (matching the Hero
     and Sérum chapters, not a centered mobile block stretched wide) —
     the full-bleed image and gold CTA already read as spectacular at any
     width, this just gives the copy the same measured, non-generic
     placement as the rest of the site. */
  @media (min-width: 1024px) {
    .final__content {
      text-align: left;
      max-width: 620px;
      padding-left: clamp(64px, 8vw, 120px);
    }
    .final__title,
    .final__subtitle {
      margin-inline: 0;
    }
    .final__title {
      font-size: clamp(3.2rem, 4.6vw, 4.8rem);
      max-width: 13ch;
    }
  }
</style>
