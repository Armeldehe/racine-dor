---
// Phase 8.3 — "Chapitre Sérum": précision / goutte / application ciblée.
// Deliberately a different compositional strategy from BeurreShowcase
// (single moody macro photo, vs. layered texture+jar) — see
// BeurreShowcase.astro's own header comment.
//
// Post-8.4 micro polish: removed the "01" numeral + vertical accent line
// that used to sit over the bottom-left of the photo — it read as a
// slide number, not a meaningful device, and the photo is cleaner without it.
import { Image } from 'astro:assets';
import serumDropMacro from '../assets/img/serum-drop-macro.jpg';
import { PRODUCTS, buildWhatsAppLink, greetingFor, priceToNumber } from '../config/site';

const serum = PRODUCTS.serum100;
const message = greetingFor(serum.name, serum.price);
const href = buildWhatsAppLink(message);
const price = priceToNumber(serum.price);
---

<div
  class="serum-showcase"
  data-cta-label={serum.ctaLabel}
  data-cta-message={message}
  data-cta-mode="contextual"
  data-cta-track-source="serum"
  data-cta-track-item="serum_100"
  data-cta-track-item-type="product"
  data-cta-track-price={price}
>
  <div class="serum-showcase__frame">
    <Image
      src={serumDropMacro}
      alt="Goutte de Sérum Capillaire Fortifiant Racine d'Or suspendue à l'embout du flacon, ambiance botanique dorée"
      widths={[420, 700, 960]}
      sizes="(min-width: 900px) 55vw, 100vw"
      loading="lazy"
      class="serum-showcase__img"
      data-reveal
    />
    <div class="serum-showcase__scrim" aria-hidden="true"></div>
  </div>

  <div class="serum-showcase__body">
    <p class="serum-showcase__eyebrow" data-reveal>Précision · goutte à goutte</p>
    <h3 class="serum-showcase__name" data-reveal style="--i:1">Sérum Capillaire<br />Fortifiant</h3>
    <p class="serum-showcase__volume" data-reveal style="--i:2">100 ml</p>
    <p class="serum-showcase__price" data-reveal style="--i:3">{serum.price}</p>
    <p class="serum-showcase__text" data-reveal style="--i:4">{serum.description}</p>
    <a
      class="serum-showcase__cta"
      data-reveal
      style="--i:5"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      data-track-source="serum"
      data-track-item="serum_100"
      data-track-item-type="product"
      data-track-price={price}
    >
      Commander sur WhatsApp
    </a>
  </div>

  <!-- Organic curve into the Beurre chapter — a raccord, never a 100vh
       transition section of its own. -->
  <svg class="serum-showcase__divider" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M0,58 C220,100 380,10 620,34 C900,62 1080,96 1440,40 L1440,100 L0,100 Z"
      class="serum-showcase__divider-fill"
    ></path>
  </svg>
</div>

<style>
  .serum-showcase {
    position: relative;
    background: var(--forest-deep);
    color: var(--text-on-forest);
    padding-bottom: 9vh;
    overflow: hidden;
  }
  .serum-showcase__frame {
    position: relative;
    height: 62svh;
    overflow: hidden;
  }
  .serum-showcase__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 45%;
  }
  .serum-showcase__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 12, 8, 0.05) 0%, rgba(10, 12, 8, 0.55) 100%);
    pointer-events: none;
  }
  .serum-showcase__body {
    position: relative;
    z-index: 1;
    padding: clamp(28px, 6vh, 48px) var(--gutter) 0;
    max-width: 640px;
  }
  .serum-showcase__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-gold);
  }
  .serum-showcase__name {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-hero);
    line-height: var(--lh-display);
  }
  .serum-showcase__volume {
    margin-top: 12px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted-on-dark);
  }
  .serum-showcase__price {
    margin-top: 8px;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 1.6rem;
    color: var(--text-gold);
    font-variant-numeric: tabular-nums;
  }
  .serum-showcase__text {
    margin-top: 16px;
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 500;
    line-height: var(--lh-body);
    color: var(--text-muted-on-dark);
    max-width: 40ch;
  }
  .serum-showcase__cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--btn-min-height);
    margin-top: 24px;
    padding: var(--btn-padding-y) var(--btn-padding-x);
    border-radius: var(--btn-radius);
    background: var(--text-on-forest);
    color: #1b1607;
    font-family: var(--btn-font);
    font-weight: var(--btn-font-weight);
    font-size: var(--btn-font-size);
    text-decoration: none;
  }

  .serum-showcase__divider {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: 9vh;
    display: block;
  }
  .serum-showcase__divider-fill {
    fill: var(--ivoire);
  }

  .js-reveal .serum-showcase__body [data-reveal] {
    transition-delay: calc(var(--i, 0) * 90ms);
  }
</style>
