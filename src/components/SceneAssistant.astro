---
// RoutineFinder — Phase 8.3 visual redesign. Business logic (the
// recommend() function in assistant.ts, and every data-assist-* contract
// it queries) is UNCHANGED — only the presentation and step-transition
// choreography changed. Two questions, four possible outcomes (an
// individual product or one of the three kits), never a medical
// diagnosis.
import { Image } from 'astro:assets';
import serumHeroMobile from '../assets/img/serum-hero-mobile.jpg';
import butterOpenHero from '../assets/img/butter-open-hero.jpg';
import routineCibleeHero from '../assets/img/routine-ciblee-hero.jpg';
import duoHero from '../assets/img/duo-hero.jpg';
import boosterHero from '../assets/img/booster-hero.jpg';

const needs = [
  { id: 'simple', label: 'Je veux une routine simple' },
  { id: 'nourrir-fortifier', label: 'Mes cheveux ont besoin d’être nourris et fortifiés' },
  { id: 'zones-fragilisees', label: 'Je veux prendre soin de zones particulièrement fragilisées' },
  { id: 'complete', label: 'Je veux la routine la plus complète' },
];

const formats = [
  { id: 'un-soin', label: 'Un seul soin' },
  { id: 'deux-produits', label: 'Deux produits' },
  { id: 'routine-complete', label: 'Une routine complète' },
];

// Every possible recommend() outcome, matched by id to a real, already-
// used photograph — never a generated/invented image.
const resultImages = [
  { id: 'serum100', src: serumHeroMobile, alt: 'Sérum Capillaire Fortifiant Racine d’Or' },
  { id: 'butter', src: butterOpenHero, alt: 'Beurre Rénovateur Racine d’Or, pot ouvert' },
  { id: 'routine-ciblee', src: routineCibleeHero, alt: 'Routine Ciblée Racine d’Or : Sérum et Derma Roller' },
  { id: 'duo-croissance', src: duoHero, alt: 'Duo Croissance Racine d’Or : Sérum et Beurre Rénovateur' },
  { id: 'booster', src: boosterHero, alt: 'Booster Racine d’Or : Sérum, Beurre Rénovateur et Derma Roller' },
];
---

<section id="assistant" class="assistant" data-cta-label="Commander" data-cta-mode="compact" aria-labelledby="assistant-h">
  <div class="assistant__panel" data-assistant>
    <!-- step 0 : intro -->
    <div class="assistant__step" data-assist-step>
      <p class="assistant__eyebrow">Consultation Racine d'Or</p>
      <h2 id="assistant-h" class="assistant__title">Trouvons la routine<br />qui te correspond.</h2>
      <p class="assistant__lede">
        Quelques choix suffisent pour t'orienter vers la routine Racine d'Or la plus adaptée à tes
        besoins.
      </p>
      <button type="button" class="assistant__cta" data-assist-start>Commencer</button>
    </div>

    <!-- step 1 : need -->
    <div class="assistant__step assistant__step--question" data-assist-step hidden>
      <div class="assistant__progress" aria-hidden="true">
        <span class="assistant__progress-label">Question 01</span>
        <span class="assistant__progress-track"><span class="assistant__progress-dot assistant__progress-dot--q1"></span></span>
        <span class="assistant__progress-label">02</span>
      </div>
      <p class="assistant__qtext">Qu'est-ce qui correspond<br />le mieux à ton besoin ?</p>
      <div class="assistant__options" role="list">
        {needs.map((n) => (
          <button type="button" class="assistant__opt" data-assist-need={n.id}>
            <span class="assistant__opt-text">{n.label}</span>
            <span class="assistant__opt-arrow" aria-hidden="true">→</span>
          </button>
        ))}
      </div>
    </div>

    <!-- step 2 : format -->
    <div class="assistant__step assistant__step--question" data-assist-step hidden>
      <div class="assistant__progress" aria-hidden="true">
        <span class="assistant__progress-label">01</span>
        <span class="assistant__progress-track"><span class="assistant__progress-dot assistant__progress-dot--q2"></span></span>
        <span class="assistant__progress-label">Question 02</span>
      </div>
      <p class="assistant__qtext">Quel type de routine<br />préfères-tu ?</p>
      <div class="assistant__options" role="list">
        {formats.map((f) => (
          <button type="button" class="assistant__opt" data-assist-format={f.id}>
            <span class="assistant__opt-text">{f.label}</span>
            <span class="assistant__opt-arrow" aria-hidden="true">→</span>
          </button>
        ))}
      </div>
    </div>

    <!-- step 3 : result -->
    <div class="assistant__step assistant__step--result" data-assist-step hidden>
      <p class="assistant__eyebrow">Ta routine</p>
      <p class="assistant__result-name" data-assist-result-name>—</p>
      <p class="assistant__result-tagline" data-assist-result-tagline></p>

      <div class="assistant__result-frame">
        {resultImages.map((r) => (
          <Image
            src={r.src}
            alt={r.alt}
            widths={[320, 480, 700]}
            sizes="(min-width: 1024px) 480px, (min-width: 640px) 360px, 82vw"
            loading="lazy"
            class="assistant__result-img"
            data-assist-result-image
            data-result-for={r.id}
            hidden
          />
        ))}
      </div>

      <p class="assistant__result-contents" data-assist-result-contents>—</p>
      <p class="assistant__result-why-label">Pourquoi cette routine ?</p>
      <p class="assistant__result-why" data-assist-result-why></p>
      <p class="assistant__disclaimer">Cette recommandation ne constitue pas un diagnostic médical.</p>
      <a class="assistant__cta assistant__cta--result" data-assist-result-cta href="#routines" target="_blank" rel="noopener noreferrer">
        Commander ma routine sur WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .assistant {
    min-height: 56svh;
    padding: clamp(48px, 10vh, 90px) var(--gutter);
    background: linear-gradient(180deg, #f1e4c6, #ead9ae);
    color: #241c0f;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .assistant__panel {
    width: 100%;
    max-width: 460px;
    text-align: center;
  }
  .assistant__step:not([hidden]) {
    animation: rd-step-in 550ms var(--ease) both;
  }
  .assistant__step--leaving {
    animation: rd-step-out 220ms var(--ease) both;
  }
  @keyframes rd-step-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes rd-step-out {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .assistant__step:not([hidden]),
    .assistant__step--leaving {
      animation: none;
    }
  }

  .assistant__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--umber);
  }
  .assistant__title {
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 10vw, 3.3rem);
    line-height: var(--lh-display);
  }
  .assistant__lede {
    margin-top: 16px;
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--text-muted-on-ivory);
  }

  .assistant__progress {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--umber);
  }
  .assistant__progress-track {
    position: relative;
    width: 64px;
    height: 1px;
    background: rgba(36, 28, 15, 0.25);
  }
  .assistant__progress-dot {
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
    transform: translate(-50%, -50%);
  }
  .assistant__progress-dot--q1 {
    left: 0%;
  }
  .assistant__progress-dot--q2 {
    left: 100%;
  }

  .assistant__qtext {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 8.5vw, 2.8rem);
    line-height: 1.2;
    margin-top: 18px;
  }

  .assistant__options {
    display: flex;
    flex-direction: column;
    margin-top: 32px;
    border-top: 1px solid rgba(36, 28, 15, 0.18);
  }
  .assistant__opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(36, 28, 15, 0.18);
    color: #241c0f;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 4.6vw, 1.35rem);
    line-height: 1.35;
    padding: 22px 6px;
    text-align: left;
    transition: color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease),
      padding-left var(--dur-fast) var(--ease);
  }
  .assistant__opt-arrow {
    flex: none;
    font-family: var(--font-body);
    font-size: 1.1rem;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .assistant__opt:hover,
  .assistant__opt:focus-visible {
    color: var(--accent-strong);
  }
  .assistant__opt:hover .assistant__opt-arrow,
  .assistant__opt:focus-visible .assistant__opt-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  /* Selected — a brief, clear flash right as the choice registers,
     before the step transitions away. No checkbox, no radio circle. */
  .assistant__opt.is-selected {
    background-color: rgba(168, 133, 59, 0.14);
    padding-left: 16px;
    color: var(--accent-strong);
  }
  .assistant__opt.is-selected .assistant__opt-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--gold);
  }

  .assistant__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--btn-min-height);
    margin-top: 30px;
    padding: var(--btn-padding-y) var(--btn-padding-x);
    border-radius: var(--btn-radius);
    background: var(--umber);
    color: var(--text-on-forest);
    font-family: var(--btn-font);
    font-weight: var(--btn-font-weight);
    font-size: var(--btn-font-size);
    text-decoration: none;
    border: none;
  }

  .assistant__step--result {
    text-align: center;
  }
  .assistant__result-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 9vw, 2.9rem);
    margin-top: 10px;
    color: var(--accent-strong);
    line-height: var(--lh-heading);
  }
  .assistant__result-tagline {
    margin-top: 4px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-muted-on-ivory);
  }
  .assistant__result-frame {
    position: relative;
    margin: 22px auto 0;
    width: min(100%, 360px);
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
  }
  .assistant__result-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .assistant__result-contents {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .assistant__result-why-label {
    margin-top: 22px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--umber);
  }
  .assistant__result-why {
    margin-top: 8px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--lh-small);
    color: var(--text-muted-on-ivory);
  }
  .assistant__disclaimer {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--text-muted-on-ivory);
  }
  .assistant__cta--result {
    background: var(--gold);
    color: #1b1607;
  }

  /* Phase 10 — desktop: a real two-column consultation instead of the
     mobile column stretched vertically. Business logic/copy untouched —
     only which side of the panel each existing element sits on. */
  @media (min-width: 1024px) {
    .assistant {
      min-height: 76vh;
    }
    .assistant__panel {
      max-width: 1080px;
    }
    /* :not([hidden]) is required — assistant.ts shows exactly one step at
       a time via the native `hidden` attribute, and an unscoped `display`
       here would override that (an author-origin rule always beats the
       UA stylesheet's `[hidden]{display:none}`, regardless of
       specificity), showing every step stacked at once. */
    .assistant__step--question:not([hidden]) {
      display: grid;
      grid-template-columns: minmax(280px, 1fr) minmax(360px, 1.15fr);
      column-gap: clamp(48px, 6vw, 96px);
      align-items: center;
      text-align: left;
    }
    .assistant__step--question .assistant__progress {
      justify-content: flex-start;
    }
    .assistant__options {
      margin-top: 0;
    }
    .assistant__step--result:not([hidden]) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(48px, 6vw, 96px);
      align-items: center;
      text-align: left;
    }
    .assistant__result-frame {
      grid-column: 2;
      grid-row: 1 / -1;
      margin: 0;
      width: 100%;
      max-width: none;
      aspect-ratio: 3 / 4;
    }
  }
</style>
