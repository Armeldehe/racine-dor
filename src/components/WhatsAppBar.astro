---
import { DEFAULT_CTA_LABEL, buildWhatsAppLink, greetingFor } from '../config/site';

const defaultHref = buildWhatsAppLink(greetingFor('un produit Racine d’Or'));
---

<div class="wa-bar wa-bar--hidden" data-cta-bar inert aria-hidden="true">
  <a
    class="wa-bar__link"
    data-cta-bar-link
    href={defaultHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${DEFAULT_CTA_LABEL} sur WhatsApp`}
    data-track-source="floating_bar"
    data-track-item="generic"
    data-track-item-type="generic"
  >
    <svg class="wa-bar__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M16 3C9.373 3 4 8.373 4 15c0 2.29.638 4.43 1.744 6.257L4 29l7.94-1.69A11.93 11.93 0 0 0 16 27c6.627 0 12-5.373 12-12S22.627 3 16 3Zm0 21.8a9.76 9.76 0 0 1-4.98-1.36l-.357-.213-4.71 1.003 1.02-4.59-.234-.372A9.75 9.75 0 1 1 16 24.8Zm5.34-7.29c-.293-.147-1.734-.855-2.003-.953-.269-.098-.465-.147-.66.147-.196.293-.758.953-.929 1.148-.171.196-.343.22-.636.073-.293-.147-1.236-.455-2.354-1.452-.87-.776-1.457-1.734-1.628-2.027-.171-.293-.018-.452.129-.598.132-.132.293-.343.44-.514.147-.171.196-.293.294-.489.098-.196.049-.367-.024-.514-.073-.147-.66-1.59-.904-2.178-.238-.572-.48-.494-.66-.503l-.562-.01c-.196 0-.514.073-.783.367-.269.293-1.026 1.003-1.026 2.446 0 1.443 1.05 2.837 1.196 3.033.147.196 2.067 3.157 5.01 4.428.7.302 1.246.483 1.672.618.702.223 1.341.191 1.846.116.563-.084 1.734-.709 1.978-1.394.245-.685.245-1.271.171-1.394-.073-.122-.269-.196-.562-.343Z"
      ></path>
    </svg>
    <span class="wa-bar__label" data-cta-bar-label>{DEFAULT_CTA_LABEL}</span>
  </a>
</div>

<style>
  .wa-bar {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: flex;
    justify-content: center;
    transition: opacity var(--dur-med) var(--ease), transform var(--dur-med) var(--ease);
  }
  .wa-bar--hidden {
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
  }
  .wa-bar__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--btn-min-height);
    gap: 10px;
    background: var(--forest-deep);
    color: var(--text-on-forest);
    font-family: var(--btn-font);
    font-weight: var(--btn-font-weight);
    font-size: var(--btn-font-size);
    padding: var(--btn-padding-y) 20px;
    border-radius: var(--btn-radius);
    text-decoration: none;
    box-shadow: 0 12px 28px rgba(10, 12, 8, 0.35);
    border: 1px solid rgba(244, 238, 220, 0.15);
    max-width: 100%;
    transition: padding var(--dur-med) var(--ease);
  }
  .wa-bar__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 280px;
    opacity: 1;
    transition: max-width var(--dur-med) var(--ease), opacity var(--dur-fast) var(--ease);
  }
  .wa-bar__icon {
    width: 20px;
    height: 20px;
    flex: none;
    color: #d9b968;
  }

  /* Compact — cinematic scenes: icon only, minimal footprint. */
  .wa-bar--compact .wa-bar__link {
    padding: 14px;
  }
  .wa-bar--compact .wa-bar__label {
    max-width: 0;
    opacity: 0;
  }
</style>
